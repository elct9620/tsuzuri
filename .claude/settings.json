{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/edit.sh\"",
            "timeout": 60,
            "statusMessage": "Formatting and linting"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/stop.sh\"",
            "timeout": 600,
            "statusMessage": "Checking what changed against CI's gates"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "daisyui@daisyui": true
  },
  "extraKnownMarketplaces": {
    "daisyui": {
      "source": {
        "source": "github",
        "repo": "saadeghi/daisyui"
      }
    }
  }
}
